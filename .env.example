# Optional: enables live Google/Bing results through SerpApi.
SERPAPI_KEY=
# Managed MySQL-compatible database URL. Local mode falls back to JSON storage when omitted.
DATABASE_URL=
# Cache duration is fixed to the product requirement of 24 hours.
PORT=3000
# Leave unset locally. Vite's dotenv loader honors NODE_ENV=development here and
# will build an unminified dev-mode client bundle, even for `pnpm build`. Set
# NODE_ENV=production only for local production-build testing; Docker sets it
# automatically at runtime.
NODE_ENV=
